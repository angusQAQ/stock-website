{
  "name": "stock-website",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --ip 0.0.0.0 --port 8787",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:research": "python3 -m unittest discover -s tests -p test_research_data.py",
    "schema:report": "node --experimental-strip-types scripts/generate-report-schema.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "npm run build && node scripts/prepare-deploy.mjs && wrangler d1 migrations apply DB --remote --config .local/deploy/wrangler.json && wrangler deploy --config .local/deploy/wrangler.json"
  },
  "dependencies": {
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "impeccable": "4.8.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  }
}
