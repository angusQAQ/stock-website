{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "stock-website-portfolio",
    // Local-only placeholder. Replace with the created D1 ID before deploying.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": { "APP_ORIGIN": "", "BRIDGE_ENABLED": "false" },
  "observability": { "enabled": true }
}
